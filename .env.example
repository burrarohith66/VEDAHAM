# PostgreSQL / Docker
POSTGRES_DB=vedaham
POSTGRES_USER=vedaham
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://vedaham:replace-with-a-local-password@localhost:5432/vedaham

# Authentication
JWT_SECRET_KEY=replace-with-a-random-32-character-minimum-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Reserved for later platform capabilities
REDIS_URL=
OPENAI_API_KEY=
